GROQ_API_KEY=gsk-...

# Groq (from groq.com) is the primary provider - fast, free tier 30 RPM.
# Models can be overridden (defaults shown):
# GROQ_MODEL=openai/gpt-oss-20b

# Gemini (from ai.google.dev) provides embeddings for RAG demos.
# GEMINI_API_KEY=...
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# With NO key set, every file falls back to an offline mock LLM + hashing
# embeddings so the logic can still be exercised (answers are extractive,
# not generated).
