OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will use OpenRouter for chat and embeddings instead - see
# _openrouter_client.py. Optional model overrides:
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_OPENAI_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
# Second model tried when the primary one fails or cannot produce parseable
# output (used by get_chat_model(..., with_fallback=True) and the 04 output
# parsers demo, e.g. when a free Gemma tier breaks on structured output):
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Or route through a local OmniRoute gateway (takes precedence if set) - NOTE:
# embeddings need an "openai" provider configured with real credentials in the
# OmniRoute dashboard first, or embed calls fail with a clear error from OmniRoute.
# OMNIROUTE_API_KEY=...
# OMNIROUTE_MODEL=cc/claude-sonnet-4-6
